# Скопируйте в .env.prod и заполните. .env.prod НЕ коммитить.
# Случайные значения: python3 -c "import secrets; print(secrets.token_hex(32))"

# Домен (DNS A-запись -> IP сервера). Без https://
DOMAIN=bot.example.com

# Telegram — ОТДЕЛЬНЫЙ бот для прода (не тестовый токен)
BOT_TOKEN=

# PostgreSQL. Пароль только из [A-Za-z0-9] (hex) — он подставляется в URL подключения
POSTGRES_DB=osialmatybot
POSTGRES_USER=osialmatybot
POSTGRES_PASSWORD=

# Админка
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SECRET_KEY=
SESSION_HTTPS_ONLY=True

# Приложение
DEBUG=False
PHOTOS_DIR=storage/photos/contractors

# Webhook (обязателен в проде)
USE_WEBHOOK=True
WEBHOOK_HOST=https://bot.example.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=

# Доступ: open | whitelist | invite_only
ACCESS_MODE=open
ADMIN_TELEGRAM_IDS=
INVITE_TOKEN=
